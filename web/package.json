{
  "name": "wordsnswords-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "WordsNSwords: vocabulary flashcards and a small dungeon game as an installable phone web app (PWA)",
  "scripts": {
    "build": "node tools/build.mjs",
    "serve": "node tools/serve.mjs",
    "test": "node --import tsx --test tests/*.test.ts",
    "golden": "python3 tools/make_golden.py",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "tsx": "4.23.12",
    "typescript": "6.0.3",
    "playwright": "1.63.0",
    "sharp": "0.35.4"
  }
}
